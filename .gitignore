# Dependências do Node
node_modules/

# Segredos e ambiente local.
# O arquivo env.example fica versionado de propósito.
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cópias do banco. Podem ter dados de pessoas e não devem ir para o GitHub.
backups/
*.dump
*.backup

# Arquivos do sistema operacional
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Backups cifrados (também ficam em backups/).
*.enc
