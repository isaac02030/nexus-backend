# ============================================
# NEXUS — Variáveis de Ambiente
# Copia este ficheiro para .env e preenche
# NUNCA coloca o .env no GitHub!
# ============================================

PORT=3000
DATABASE_URL=postgresql://usuario:password@localhost:5432/nexus_db
# Troque este valor por um segredo longo e aleatorio. Nao use o texto de exemplo.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Convite de Duo por link. So liga as rotas quando o valor e exatamente true.
# Sem a variavel, ou com qualquer outro valor, criar, ver, aceitar e recusar
# convite respondem 404. O padrao e desligado. A validade do codigo e a
# constante INVITE_TTL_HOURS em routes/invites.js (48 horas).
# NEXUS_CONVITE_POR_LINK=true
